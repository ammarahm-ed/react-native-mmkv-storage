{
  "name": "react-native-mmkv-storage",
  "version": "13.0.0",
  "description": "This library aims to provide a fast & reliable solution for you data storage needs in react-native apps. It uses [MMKV](https://github.com/Tencent/MMKV) by Tencent under the hood on Android and iOS both that is used by their WeChat app(more than 1 Billion users). Unlike other storage solutions for React Native, this library lets you store any kind of data type, in any number of database instances, with or without encryption in a very fast and efficient way.",
  "main": "./dist/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc",
    "prepack": "bash scripts/check-mmkv-assets.sh",
    "mmkv:update": "bash scripts/update-mmkv.sh",
    "mmkv:check": "bash scripts/update-mmkv.sh --check",
    "watch": "tsc --watch",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "react-native",
    "fast-storage",
    "react",
    "native",
    "asyncstorage",
    "async-storage",
    "mmkv-database",
    "mmkv-storage",
    "encrypted-storage",
    "encryption",
    "mmkv",
    "android",
    "ios",
    "key-value-storage",
    "database",
    "fast",
    "storage",
    "persist-storage",
    "secure-storage",
    "redux-persist-storage",
    "react-native-mmkv-storage"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ammarahm-ed/react-native-mmkv-storage.git"
  },
  "author": "Ammar Ahmed for @ammarahm-ed",
  "license": "MIT",
  "peerDependencies": {
    "react-native": "*"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/runtime": "^7.26.0",
    "@types/react": "^19.2.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native/babel-preset": "0.87.0-rc.4",
    "@react-native/eslint-config": "0.87.0-rc.4",
    "@react-native/metro-config": "0.87.0-rc.4",
    "@react-native/typescript-config": "0.87.0-rc.4",
    "metro": "^0.87.0",
    "jest": "^29.2.1",
    "react": "19.2.3",
    "react-native": "0.87.0-rc.4",
    "typescript": "^5.1.6",
    "eslint": "^8.57.1",
    "@react-native-community/eslint-config": "^3.2.0",
    "vitepress": "^1.6.3"
  },
  "codegenConfig": {
    "name": "MMKVStorageSpec",
    "type": "modules",
    "jsSrcsDir": "./src",
    "android": {
      "javaPackageName": "com.ammarahmed.mmkv"
    }
  }
}
